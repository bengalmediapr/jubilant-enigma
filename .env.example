# Copy to .env and fill in, then: set -a; source .env; set +a
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
# Optional: adds a real Google mobile speed score to each audit
PAGESPEED_API_KEY=
SENDER_NAME="Tu Nombre"
# CAN-SPAM requires a real physical postal address (a PO box/apartado works)
SENDER_ADDRESS="PO Box 0000, San Juan, PR 00900"
